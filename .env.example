# API
API_PORT=8000
CORS_ORIGINS=*

# Logging
LOG_LEVEL=INFO
LOG_TO_FILE=false

# AWS & S3
AWS_REGION=ap-south-1
S3_BUCKET=
S3_PREFIX=features
REFRESH_SECONDS=300

# Only needed when there is no AWS CLI profile or IAM role (local Docker, or secondary EC2 path).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Database (Postgres)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=chhaya_db

ROOT_PATH=